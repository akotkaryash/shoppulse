# ==========================================
# ShopPulse Configuration Template
# ==========================================

# 1. PostgreSQL Configuration
POSTGRES_USER=shoppulse
POSTGRES_PASSWORD=shoppulse_secret
POSTGRES_DB=shoppulse

# 2. Frontend Configuration
# ------------------------------------------
# FOR DEVELOPMENT:
# Set DOCKERFILE_PATH=Dockerfile.dev
# Set HOST_PORT=4200
# Set CONTAINER_PORT=4200
#
# FOR PRODUCTION:
# Set DOCKERFILE_PATH=Dockerfile
# Set HOST_PORT=4200
# Set CONTAINER_PORT=80
# ------------------------------------------

DOCKERFILE_PATH=Dockerfile.dev
HOST_PORT=4200
CONTAINER_PORT=4200